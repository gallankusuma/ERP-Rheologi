{
  "name": "backend",
  "version": "1.0.0",
  "description": "ERP backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts --clear-screen=false",
    "dev:auto": "tsx watch src/index.ts --clear-screen=false",
    "build": "tsc",
    "build:ci": "tsc --skipLibCheck",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "node init-database.js",
    "test:ppic": "tsx tests/ppic-smoke.ts",
    "test:procurement-neg": "tsx tests/procurement-negative.ts",
    "test:production-neg": "tsx tests/production-negative.ts",
    "test:qc-neg": "tsx tests/qc-negative.ts",
    "test:negative": "tsx tests/procurement-negative.ts && tsx tests/production-negative.ts && tsx tests/qc-negative.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:verify": "tsx src/scripts/migrate-verify.ts",
    "test:valuation": "tsx src/scripts/valuation-check.ts",
    "test:grn-lines": "tsx src/scripts/grn-lines-check.ts",
    "test:finance-config": "tsx src/scripts/finance-config-check.ts",
    "test:payables": "tsx src/scripts/payables-check.ts",
    "test:sales-posting": "tsx src/scripts/sales-posting-check.ts",
    "test:acceptance": "tsx src/scripts/acceptance-check.ts",
    "test:reconciliation": "tsx src/scripts/reconciliation-check.ts",
    "test:three-way-match": "tsx src/scripts/three-way-match-check.ts",
    "test:returns": "tsx src/scripts/returns-check.ts",
    "test:reversal": "tsx src/scripts/reversal-check.ts",
    "test:fund-request": "tsx src/scripts/fund-request-check.ts"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.1.0",
    "imapflow": "^1.6.6",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.15",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
